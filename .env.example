# NEXT_PUBLIC_SITE_URL / VITE_SITE_URL: Canonical site URL used for SEO metadata, OpenGraph, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://photo-strip-maker.vercel.app"
VITE_SITE_URL="https://photo-strip-maker.vercel.app"

# GEMINI_API_KEY: Optional environment variable injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional runtime URL injected by hosting environment.
APP_URL="MY_APP_URL"
